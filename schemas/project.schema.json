{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tene-ai/tene-codex/schemas/project.schema.json",
  "title": "tene-workflow project state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "profile",
    "master_plan",
    "revision",
    "sprints",
    "tasks",
    "intents",
    "acceptance_criteria",
    "gaps",
    "waivers",
    "approvals",
    "evidence",
    "qa_runs",
    "graph"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^project_[0-9a-z]+$"},
    "name": {"type": "string", "minLength": 1},
    "profile": {"enum": ["strict", "standard", "light", "off"]},
    "master_plan": {"$ref": "#/$defs/master_plan"},
    "active_sprint_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "sprints": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sprint"}},
    "tasks": {"type": "object"},
    "intents": {"type": "object"},
    "acceptance_criteria": {"type": "object"},
    "gaps": {"type": "object"},
    "waivers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/waiver"}},
    "approvals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/approval"}},
    "evidence": {"type": "object"},
    "qa_runs": {"type": "object"},
    "graph": {"type": "object"},
    "request_results": {"type": "object"}
  },
  "$defs": {
    "master_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["objective", "milestones", "releases", "common_risks", "cross_sprint_invariants"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "milestones": {"type": "array", "items": {"type": "string"}},
        "releases": {"type": "array", "items": {"type": "string"}},
        "common_risks": {"type": "array", "items": {"type": "string"}},
        "cross_sprint_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "sprint_id", "from", "to", "reason", "requester", "status", "requested_at", "expires_at"],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^approval_[0-9a-z]+$"},
        "sprint_id": {"type": "string"},
        "from": {"enum": ["draft", "prd", "plan", "design", "do", "loop-check", "qa", "report", "archived"]},
        "to": {"enum": ["draft", "prd", "plan", "design", "do", "loop-check", "qa", "report", "archived"]},
        "reason": {"type": "string", "minLength": 1}, "requester": {"type": "string", "minLength": 1}, "approver": {"type": "string", "minLength": 1},
        "status": {"enum": ["requested", "approved", "consumed"]},
        "requested_at": {"type": "string", "format": "date-time"}, "approved_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "consumed_at": {"type": "string", "format": "date-time"}
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "sprint_id", "gap_id", "reason", "scope", "approver", "status", "created_at", "expires_at"],
      "properties": {
        "waiver_id": {"type": "string", "pattern": "^waiver_[0-9a-z]+$"}, "sprint_id": {"type": "string"}, "gap_id": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "approver": {"type": "string", "minLength": 1},
        "status": {"enum": ["requested", "active", "revoked", "expired"]}, "requester": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "requested_at": {"type": "string", "format": "date-time"}, "approved_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "revoked_at": {"type": "string", "format": "date-time"}, "expired_at": {"type": "string", "format": "date-time"}
      }
    },
    "sprint": {
      "type": "object",
      "required": ["sprint_id", "slug", "title", "phase", "document_root"],
      "properties": {
        "sprint_id": {"type": "string", "pattern": "^sprint_[0-9a-z]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "milestone": {"type": "string"},
        "release": {"type": "string"},
        "phase": {"enum": ["draft", "prd", "plan", "design", "do", "loop-check", "qa", "report", "archived"]},
        "document_root": {"type": "string"},
        "loop_iteration": {"type": "integer", "minimum": 0},
        "max_loop_iterations": {"type": "integer", "minimum": 1, "maximum": 20},
        "last_loop_outcome": {"enum": ["repair", "passed", "blocked"]},
        "last_loop_summary": {"type": "string"},
        "last_loop_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
