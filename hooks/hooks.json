{
  "description": "tene-codex context restoration and secret-safety hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py session-start",
            "timeout": 10,
            "statusMessage": "Loading the active tene sprint",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py pre-tool",
            "timeout": 5,
            "statusMessage": "Checking tene safety boundaries"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py pre-compact",
            "timeout": 10,
            "statusMessage": "Saving a resumable tene snapshot",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py post-tool",
            "timeout": 5,
            "statusMessage": "Scanning output for secret leakage",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py subagent-start",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/tene_hook.py stop",
            "timeout": 10,
            "statusMessage": "Checking the active tene sprint before stopping",
            "additionalContextLimit": 1500
          }
        ]
      }
    ]
  }
}
