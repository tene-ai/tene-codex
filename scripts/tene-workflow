#!/bin/sh
set -eu

plugin_root=${PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
os_name=$(uname -s | tr '[:upper:]' '[:lower:]')
arch_name=$(uname -m)
case "$arch_name" in
  x86_64) arch_name=amd64 ;;
  arm64|aarch64) arch_name=arm64 ;;
esac

bundled="$plugin_root/bin/${os_name}-${arch_name}/tene-workflow"
if [ -x "$bundled" ]; then
  checksum_file="$plugin_root/checksums.txt"
  relative="./bin/${os_name}-${arch_name}/tene-workflow"
  if [ ! -f "$checksum_file" ]; then
    echo "tene-workflow checksum manifest is missing" >&2
    exit 7
  fi
  expected=$(awk -v target="$relative" '$2 == target { print $1 }' "$checksum_file")
  actual=$(shasum -a 256 "$bundled" | awk '{print $1}')
  if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
    echo "tene-workflow bundled binary checksum verification failed" >&2
    exit 7
  fi
  exec "$bundled" "$@"
fi

if [ -f "$plugin_root/go.mod" ] && command -v go >/dev/null 2>&1; then
  cd "$plugin_root"
  exec go run ./cmd/tene-workflow "$@"
fi

if command -v tene-workflow >/dev/null 2>&1; then
  exec tene-workflow "$@"
fi

echo "tene-workflow binary not found for ${os_name}-${arch_name}" >&2
echo "Install a release binary or build ./cmd/tene-workflow." >&2
exit 5
